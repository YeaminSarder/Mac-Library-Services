				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Determine the working directory from the first selected item
first_arg="${1:-.}"
if [ -d "$first_arg" ]; then
    dir="$first_arg"
else
    dir="$(dirname "$first_arg")"
fi

# Safely format all selected files/arguments, preserving spaces inside names
formatted_files=""
for f in "$@"; do
    formatted_files+="$(printf '%q ' "$f")"
done

wez_bin="/Applications/WezTerm.app/Contents/MacOS/wezterm"
tmp_dir=$(mktemp -d)

cat &lt;&lt; EOF &gt; "$tmp_dir/.zshrc"
# Load main configuration
[ -f ~/.zshenv ] &amp;&amp; source ~/.zshenv
[ -f ~/.zprofile ] &amp;&amp; source ~/.zprofile
[ -f ~/.zshrc ] &amp;&amp; source ~/.zshrc

# Inject the properly escaped filename list into the ZLE buffer
_prefill_filename() {
    BUFFER=" $formatted_files"
    CURSOR=0
    zle -D zle-line-init
}
zle -N zle-line-init _prefill_filename
EOF

# Launch WezTerm in the target directory with the pre-filled buffer
ZDOTDIR="$tmp_dir" "$wez_bin" start --cwd "$dir" &amp;</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
					<string></string>
				</dict>
